* text=auto eol=lf

# SH / PHP / JS / CSS 必须在 Linux 上以 LF 运行，禁止被 checkout 成 CRLF
*.sh      text eol=lf
*.bash    text eol=lf
*.php     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.md      text eol=lf
*.conf    text eol=lf
*.tpl     text eol=lf
*.in      text eol=lf
*.ini     text eol=lf
*.cnf     text eol=lf
*.service text eol=lf
*.md      text eol=lf

# 二进制资源不做换行转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.gz      binary
*.tar     binary
*.zip     binary
*.deb     binary
