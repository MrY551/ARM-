# Xiao Huang for Kylin ARM64 —— MySQL 配置
# 参数来自 Windows 版 app/Extensions/MySQL5.7.26/my.ini，
# 对 MySQL 8.x 不兼容项统一加 loose- 前缀（未知参数降级为警告而不是启动失败）

[mysql]
default-character-set=utf8

[mysqld]
user=root
port=@DB_PORT@
basedir=@MYSQL_BASEDIR@
datadir=@MYSQL_DATA@
socket=@RUN_DIR@/mysql.sock
pid-file=@RUN_DIR@/mysqld.pid
log-error=@MYSQL_HOME@/log/error.log
secure_file_priv=@MYSQL_HOME@/upload
tmpdir=@MYSQL_HOME@/tmp

character-set-server=utf8
collation-server=utf8_unicode_ci
init_connect='SET NAMES utf8'
default-storage-engine=MyISAM
max_connections=100
max_allowed_packet=16M
max_heap_table_size=64M
table_open_cache=256
thread_cache_size=16
tmp_table_size=64M
sort_buffer_size=256K
read_buffer_size=512K
read_rnd_buffer_size=4M
join_buffer_size=2M
key_buffer_size=32M
myisam_max_sort_file_size=64G
myisam_sort_buffer_size=32M
interactive_timeout=120
wait_timeout=120
server_id=1
# MySQL 5.7 有 log_error_verbosity，MariaDB 10.x 没有；loose- 保证 MariaDB 不报未知变量
loose-log_error_verbosity=1

innodb_buffer_pool_size=64M
innodb_flush_log_at_trx_commit=1
innodb_lock_wait_timeout=120
innodb_log_buffer_size=4M
# MySQL 5.7 参数；8.0.30+ 用 innodb_redo_log_capacity 取代，loose- 保证不报错
loose-innodb_log_file_size=256M
loose-innodb_redo_log_capacity=268435456

# 5.x 参数，8.0 已移除；loose- 前缀避免启动失败
loose-skip-external-locking=ON
loose-query_cache_type=0
loose-query_cache_size=0

skip-name-resolve=OFF
# skip-host-cache 不接受参数（MySQL 8 会因 =ON 直接启动失败）
skip-host-cache
lower_case_table_names=0
explicit_defaults_for_timestamp=ON
loose-default_authentication_plugin=mysql_native_password
loose-authentication_policy=mysql_native_password

[client]
port=@DB_PORT@
socket=@RUN_DIR@/mysql.sock
default-character-set=utf8
