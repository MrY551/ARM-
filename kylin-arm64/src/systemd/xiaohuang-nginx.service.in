[Unit]
Description=Xiao Huang Nginx (by 小黄 · Kylin ARM64)
After=network-online.target
Wants=network-online.target

[Service]
# 前台运行，systemd 直接管进程；启动失败时错误会完整进 journal
Type=simple
ExecStart=@NGINX_BIN@ -c @NGINX_HOME@/conf/nginx.conf -p @NGINX_HOME@ -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -QUIT $MAINPID
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xiaohuang-nginx

[Install]
WantedBy=multi-user.target
